<Page
    x:Class="MetroMarkdownEditor.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DataContext="{Binding Main, Source={StaticResource Locator}}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#2D2D30" />
                    <SolidColorBrush x:Key="TilePathTextBrush" Color="#999999" />
                </ResourceDictionary>
                
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="TilePathTextBrush" Color="#666666" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition />
        </TransitionCollection>
    </Page.Transitions>

    <Grid x:Name="LayoutRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Background Image (Default or Custom mode) -->
        <Image x:Name="BackgroundImage"
               Source="{Binding Background.BackgroundImage, Source={StaticResource Locator}}"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="{Binding Background.ShowBackground, Source={StaticResource Locator}, Converter={StaticResource BoolToVisibilityConverter}}" />
        
        <!-- Overlay for readability (Custom mode only) -->
        <Rectangle x:Name="BackgroundOverlay"
                   Visibility="{Binding Background.ShowOverlay, Source={StaticResource Locator}, Converter={StaticResource BoolToVisibilityConverter}}" />
        
        <!-- Main Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


        <StackPanel Margin="48,81,48,0" RenderTransformOrigin="0.5,0.285">
            <TextBlock Style="{StaticResource HeaderTextBlockStyle}"
                       FontSize="96"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}" Height="52">
                <Run FontWeight="SemiBold" Text="Mark" /><Run FontWeight="SemiBold" Text="::" /><Run FontWeight="Light" Text="Blocks" />
            </TextBlock>
                <TextBlock Text="A clean Metro style markdown editor for all windows platforms."
                       Margin="2,4,2,16"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Opacity="0.6" Height="24" />
            </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="48,24,48,0">
            <Button Content="New"
                    Width="160"
                    Height="56"
                    Command="{Binding NewCommand}"
                    Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                    FontSize="18" />
            <Button Content="Open"
                    Width="160"
                    Height="56"
                    Command="{Binding OpenCommand}"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                    FontSize="18"
                    Margin="16,0,0,0" />
            <Button Content="Settings"
                    Width="160"
                    Height="56"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                    FontSize="18"
                    Margin="16,0,0,0">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Appearance" Click="AppearanceSettings_Click" />
                        <MenuFlyoutItem Text="Markdown" Click="MarkdownSettings_Click" />
                        <MenuFlyoutItem Text="Editor" Click="EditorSettings_Click" />
                        <MenuFlyoutItem Text="Image" Click="ImageSettings_Click" />
                        <MenuFlyoutItem Text="Export" Click="ExportSettings_Click" />
                        <MenuFlyoutItem Text="Auto Save" Click="AutoSaveSettings_Click" />
                        <MenuFlyoutItem Text="Developer" Click="DevSettings_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="48,24,48,0">
            <TextBlock Text="Recent files"
                       Margin="0,0,0,12"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       FontSize="18" Height="43" />
            <GridView ItemsSource="{Binding RecentFiles}"
                      SelectionMode="None"
                      Margin="0,0,0,12">
                <GridView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromHorizontalOffset="400" />
                    </TransitionCollection>
                </GridView.ItemContainerTransitions> 
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapGrid ItemWidth="320" ItemHeight="160" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenRecentCommand, ElementName=LayoutRoot}"
                                CommandParameter="{Binding}"
                                BorderThickness="0"
                                Background="Transparent"
                                Padding="0" 
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <Border Width="310"
                                    Height="145"
                                    Background="{ThemeResource TileBackgroundBrush}"
                                    Margin="5"
                                    Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Top"
                                               Foreground="{ThemeResource ApplicationForegroundThemeBrush}" />
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Path}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TilePathTextBrush}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Bottom"
                                               Margin="0,5,0,0" />
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
        </Grid>
    </Grid>
</Page>
