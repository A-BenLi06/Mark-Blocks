---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-grid">
    <div class="footer-block footer-brand">
      <div class="brand-name">Mark<span class="brand-colon">::</span>Blocks</div>
      <p class="footer-tag">纯扁平。纯磁贴。纯 Metro。</p>
    </div>
    <div class="footer-block">
      <h4 class="footer-head">链接</h4>
      <ul class="footer-list">
        <li><a href="https://github.com/A-BenLi06/MetroMarkdownEditor" target="_blank" rel="noopener">GitHub 仓库</a></li>
        <li><a href="https://github.com/A-BenLi06/MetroMarkdownEditor/releases" target="_blank" rel="noopener">Releases</a></li>
        <li><a href="https://github.com/A-BenLi06/MetroMarkdownEditor/issues" target="_blank" rel="noopener">Issues</a></li>
        <li><a href="/docs/">文档</a></li>
      </ul>
    </div>
    <div class="footer-block">
      <h4 class="footer-head">平台</h4>
      <ul class="footer-list">
        <li>Windows 8.1+</li>
        <li>Windows RT 8.1+</li>
        <li>Windows Phone 8.1+</li>
      </ul>
    </div>
    <div class="footer-block">
