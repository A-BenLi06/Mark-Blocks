<Application
    x:Class="MetroMarkdownEditor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MetroMarkdownEditor.ViewModels"
    xmlns:conv="using:MetroMarkdownEditor.Converters"
    xmlns:common="using:MetroMarkdownEditor.Common">
    <Application.Resources>
        <ResourceDictionary>
            <vm:ViewModelLocator x:Key="Locator" />
            <conv:ViewModeToGridLengthConverter x:Key="ViewModeToGridLengthConverter" />
            <conv:ViewModeToVisibilityConverter x:Key="ViewModeToVisibilityConverter" />
            <common:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

