    <Compile Include="$(MSBuildThisFileDirectory)Services\RecentFileService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Services\ThemeService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ViewModels\BaseViewModel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ViewModels\DocumentViewModel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ViewModels\EditorNavigationRequest.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ViewModels\EditorViewMode.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ViewModels\EditorViewModel.cs" />
