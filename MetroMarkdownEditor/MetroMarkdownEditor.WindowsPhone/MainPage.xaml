<Page
    x:Class="MetroMarkdownEditor.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MetroMarkdownEditor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    DataContext="{Binding Main, Source={StaticResource Locator}}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#2D2D30" />
                    <SolidColorBrush x:Key="TilePathTextBrush" Color="#999999" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="TilePathTextBrush" Color="#666666" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <!-- Custom Background Image (if set) -->
        <Image x:Name="BackgroundImage"
               Source="{Binding Background.BackgroundImage, Source={StaticResource Locator}}"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="{Binding Background.UseCustomBackground, Source={StaticResource Locator}, Converter={StaticResource BoolToVisibilityConverter}}" />
        
        <!-- Overlay for readability (Dark: 70% black, Light: 70% white) -->
        <Rectangle x:Name="BackgroundOverlay"
                   Visibility="{Binding Background.UseCustomBackground, Source={StaticResource Locator}, Converter={StaticResource BoolToVisibilityConverter}}" />
        
        <!-- Main Content -->
        <Pivot Title="METRO MARKDOWN EDITOR">
            <PivotItem Header="home">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="19,12,19,0">
                        <TextBlock Text="A clean markdown editor for Windows."
                                   Margin="0,0,0,12"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Opacity="0.6" 
                                   FontSize="14"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="19,0,19,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <Button Content="New"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Height="56"
                                Command="{Binding NewCommand}"
                                Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                FontSize="18" 
                                Margin="0,0,6,0"/>
                        
                        <Button Content="Open"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Height="56"
                                Command="{Binding OpenCommand}"
                                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                FontSize="18"
                                Margin="6,0,0,0" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="19,0,19,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Recent files"
                                   Margin="0,0,0,12"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   FontSize="18" />

                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding RecentFiles}"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                  ItemClick="RecentFiles_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                         <TextBlock Text="{Binding Name}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}" />
                                         <TextBlock Text="{Binding Path}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TilePathTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </PivotItem>

            <PivotItem Header="settings">
                <ScrollViewer>
                    <StackPanel Margin="19,12,19,0">
                        <!-- Auto Save Setting -->
                        <ToggleSwitch Header="Auto Save" 
                                      IsOn="{Binding AutoSaveEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Automatically save changes when switching files or exiting."
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Opacity="0.6"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,24" />

                        <!-- Theme Background Setting -->
                        <TextBlock Text="Background Theme"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Set a custom background image for the main page."
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Opacity="0.6"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        
                        <Button Content="Choose Image"
                                Click="ChooseBackground_Click"
                                HorizontalAlignment="Stretch"
                                Height="48"
                                FontSize="16"
                                Margin="0,0,0,8" />
                        
                        <Button Content="Reset to Default"
                                Click="ResetBackground_Click"
                                HorizontalAlignment="Stretch"
                                Height="48"
                                FontSize="16"
                                Visibility="{Binding Background.UseCustomBackground, Source={StaticResource Locator}, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Accent Color Setting -->
                        <TextBlock Text="Accent Color"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Margin="0,24,0,8" />
                        <TextBlock Text="Use system accent color instead of the default cyan."
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Opacity="0.6"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <ToggleSwitch x:Name="UseSystemAccentToggle"
                                      Header="Use system accent color"
                                      IsOn="{Binding Theme.UseSystemAccentColor, Source={StaticResource Locator}, Mode=TwoWay}" />

                        <!-- Preview Theme Setting -->
                        <TextBlock Text="Preview Theme"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Margin="0,24,0,8" />
                        <TextBlock Text="Choose a background color for the markdown preview."
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Opacity="0.6"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <RadioButton Content="Default (Grey)"
                                     GroupName="PreviewTheme"
                                     IsChecked="{Binding Theme.IsPreviewThemeGrey, Source={StaticResource Locator}, Mode=TwoWay}"
                                     Margin="0,0,0,8" />
                        <RadioButton Content="AMOLED Black"
                                     GroupName="PreviewTheme"
                                     IsChecked="{Binding Theme.IsPreviewThemeAMOLED, Source={StaticResource Locator}, Mode=TwoWay}"
                                     Margin="0,0,0,8" />
                        <RadioButton Content="Tokyo Night"
                                     GroupName="PreviewTheme"
                                     IsChecked="{Binding Theme.IsPreviewThemeTokyoNight, Source={StaticResource Locator}, Mode=TwoWay}"
                                     Margin="0,0,0,8" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>