<Page
    x:Class="MetroMarkdownEditor.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    DataContext="{Binding Main, Source={StaticResource Locator}}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#2D2D30" />
                    <SolidColorBrush x:Key="TilePathTextBrush" Color="#999999" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="TilePathTextBrush" Color="#666666" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="LayoutRoot">
        <!-- Background Image (Default or Custom mode) -->
        <Image x:Name="BackgroundImage"
               Source="{Binding Background.BackgroundImage, Source={StaticResource Locator}}"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="{Binding Background.ShowBackground, Source={StaticResource Locator}, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Overlay (Custom mode only) -->
        <Rectangle x:Name="BackgroundOverlay"
                   Visibility="{Binding Background.ShowOverlay, Source={StaticResource Locator}, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Main Pivot -->
        <Pivot Title="MARK::BLOCKS">
            <!-- Home -->
            <PivotItem Header="home">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Description -->
                    <TextBlock Grid.Row="0"
                               Text="A clean Metro-style markdown editor for all Windows platforms."
                               Margin="19,12,19,12"
                               Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                               Opacity="0.6"
                               FontSize="14"
                               TextWrapping="Wrap" />

                    <!-- Buttons: Open + Writting -->
                    <Grid Grid.Row="1" Margin="19,0,19,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="OpenButton"
                                Content="Open"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Height="56"
                                Click="OpenButton_Click"
                                Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                FontSize="18"
                                Margin="0,0,6,0" />

                        <Button x:Name="WrittingButton"
                                Content="Writting"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Height="56"
                                Click="WrittingButton_Click"
                                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                FontSize="18"
                                Margin="6,0,0,0" />
                    </Grid>

                    <!-- Recent Files -->
                    <Grid Grid.Row="2" Margin="19,0,19,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Recent files"
                                   Margin="0,0,0,12"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   FontSize="18" />

                        <ListView Grid.Row="1"
                                  x:Name="RecentFilesListView"
                                  ItemsSource="{Binding RecentFiles}"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                  ItemClick="RecentFiles_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}" />
                                        <TextBlock Text="{Binding Path}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TilePathTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- Settings -->
            <PivotItem Header="settings">
                <ScrollViewer>
                    <StackPanel Margin="19,12,19,24">
                        <!-- File Section -->
                        <TextBlock Text="File"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Theme.AccentBrush, Source={StaticResource Locator}}"
                                   Margin="0,0,0,12" />

                        <ToggleSwitch Header="Auto Save"
                                      IsOn="{Binding AutoSaveEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Automatically save changes when switching files or exiting."
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Opacity="0.6"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,24" />

                        <!-- Theme Section -->
                        <TextBlock Text="Theme"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Theme.AccentBrush, Source={StaticResource Locator}}"
                                   Margin="0,0,0,12" />

                        <!-- MainPage Background -->
                        <TextBlock Text="MainPage Background"
                                   FontSize="18"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Choose background style for the main page."
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Opacity="0.6"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <RadioButton Content="Default (Theme Images)"
                                     GroupName="MainPageBackground"
                                     IsChecked="{Binding Background.IsDefaultMode, Source={StaticResource Locator}, Mode=TwoWay}"
                                     Margin="0,0,0,4" />
                        <RadioButton Content="Pure (Solid Color)"
                                     GroupName="MainPageBackground"
                                     IsChecked="{Binding Background.IsPureMode, Source={StaticResource Locator}, Mode=TwoWay}"
                                     Margin="0,0,0,4" />
                        <RadioButton Content="Custom Image"
                                     GroupName="MainPageBackground"
                                     IsChecked="{Binding Background.IsCustomMode, Source={StaticResource Locator}, Mode=TwoWay}"
                                     Margin="0,0,0,8" />

                        <Button Content="Choose Custom Image"
                                Click="ChooseBackground_Click"
                                HorizontalAlignment="Stretch"
                                Height="48"
                                FontSize="16"
                                Margin="0,0,0,24" />

                        <!-- Accent Colour Section -->
                        <TextBlock Text="Accent Colour"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Theme.AccentBrush, Source={StaticResource Locator}}"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="Use system accent color instead of the default cyan."
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Opacity="0.6"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <RadioButton x:Name="AppDefaultAccentRadio"
                                     Content="App Default"
                                     GroupName="AccentColor"
                                     IsChecked="{Binding Theme.UseAppDefaultAccent, Source={StaticResource Locator}, Mode=TwoWay}"
                                     Margin="0,0,0,4" />
                        <RadioButton x:Name="SystemAccentRadio"
                                     Content="Use System Accent"
                                     GroupName="AccentColor"
                                     IsChecked="{Binding Theme.UseSystemAccentColor, Source={StaticResource Locator}, Mode=TwoWay}"
                                     Margin="0,0,0,24" />

                        <!-- Preview Background Colour Section -->
                        <TextBlock Text="Preview Background Colour"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Theme.AccentBrush, Source={StaticResource Locator}}"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="Choose a background color for the markdown preview."
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Opacity="0.6"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <RadioButton Content="Default (#1d1d1d)"
                                     GroupName="PreviewTheme"
                                     IsChecked="{Binding Theme.IsPreviewThemeGrey, Source={StaticResource Locator}, Mode=TwoWay}"
                                     Margin="0,0,0,4" />
                        <RadioButton Content="AMOLED Black"
                                     GroupName="PreviewTheme"
                                     IsChecked="{Binding Theme.IsPreviewThemeAMOLED, Source={StaticResource Locator}, Mode=TwoWay}"
                                     Margin="0,0,0,4" />
                        <RadioButton Content="Tokyo Night"
                                     GroupName="PreviewTheme"
                                     IsChecked="{Binding Theme.IsPreviewThemeTokyoNight, Source={StaticResource Locator}, Mode=TwoWay}"
                                     Margin="0,0,0,8" />

                        <!-- Markdown Section -->
                        <TextBlock Text="Markdown"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Theme.AccentBrush, Source={StaticResource Locator}}"
                                   Margin="0,24,0,12" />
                        <ToggleSwitch Header="Strict Mode"
                                      IsOn="{Binding MarkdownSettings.StrictMode, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Auto Links"
                                  IsChecked="{Binding MarkdownSettings.AutoLinks, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Inline Math"
                                  IsChecked="{Binding MarkdownSettings.InlineMath, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Subscript"
                                  IsChecked="{Binding MarkdownSettings.Subscript, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Superscript"
                                  IsChecked="{Binding MarkdownSettings.Superscript, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Highlight"
                                  IsChecked="{Binding MarkdownSettings.Highlight, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="GitHub Style Alert"
                                  IsChecked="{Binding MarkdownSettings.GithubStyleAlert, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Diagrams"
                                  IsChecked="{Binding MarkdownSettings.Diagrams, Source={StaticResource Locator}, Mode=TwoWay}"
                                  Margin="0,0,0,12" />
                        <TextBlock Text="Heading Style"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Margin="0,0,0,4" />
                        <ComboBox SelectedIndex="{Binding MarkdownSettings.HeadingStyleIndex, Source={StaticResource Locator}, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="atx (#)" />
                            <ComboBoxItem Content="setext (===)" />
                        </ComboBox>
                        <TextBlock Text="Code Fences"
                                   FontSize="18"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Margin="0,16,0,8" />
                        <CheckBox Content="Display line numbers"
                                  IsChecked="{Binding MarkdownSettings.DisplayLineNumbersForCodeFences, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Auto wrap long lines"
                                  IsChecked="{Binding MarkdownSettings.AutoWrapLongLines, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <TextBlock Text="Default Code Language"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Margin="0,8,0,4" />
                        <TextBox Text="{Binding MarkdownSettings.DefaultCodeLanguage, Source={StaticResource Locator}, Mode=TwoWay}"
                                 Margin="0,0,0,12" />
                        <TextBlock Text="Whitespace / Line Break"
                                   FontSize="18"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Margin="0,4,0,8" />
                        <CheckBox Content="Indent first line of paragraphs"
                                  IsChecked="{Binding MarkdownSettings.IndentFirstLineOfParagraphs, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Visible &lt;br/&gt;"
                                  IsChecked="{Binding MarkdownSettings.VisibleLineBreaks, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <ComboBox SelectedIndex="{Binding MarkdownSettings.WritingWhitespaceModeIndex, Source={StaticResource Locator}, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,4,0,20">
                            <ComboBoxItem Content="Preserve whitespace and single line break" />
                            <ComboBoxItem Content="Preserve sequential whitespace" />
                            <ComboBoxItem Content="Collapse whitespace" />
                        </ComboBox>

                        <!-- Editor Section -->
                        <TextBlock Text="Editor"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Theme.AccentBrush, Source={StaticResource Locator}}"
                                   Margin="0,0,0,12" />
                        <CheckBox Content="Pretty indentation on save"
                                  IsChecked="{Binding EditorSettings.PrettyIndentation, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Auto pair brackets and quotes"
                                  IsChecked="{Binding EditorSettings.AutoPairBracketsAndQuotes, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Auto pair common Markdown syntax"
                                  IsChecked="{Binding EditorSettings.AutoPairCommonMarkdownSyntax, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Enable autocomplete for Emojis"
                                  IsChecked="{Binding EditorSettings.EnableEmojiAutocomplete, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Copy Markdown source as plain text"
                                  IsChecked="{Binding EditorSettings.CopyMarkdownSourceAsPlainText, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Copy or cut whole lines when there is no selection"
                                  IsChecked="{Binding EditorSettings.CopyCutWholeLinesWhenNoSelection, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <TextBlock Text="Default Line Ending"
                                   FontSize="18"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Margin="0,12,0,8" />
                        <RadioButton Content="LF (Unix Style)"
                                     GroupName="PhoneDefaultLineEnding"
                                     IsChecked="{Binding EditorSettings.IsDefaultLineEndingLF, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <RadioButton Content="CRLF (Windows Style)"
                                     GroupName="PhoneDefaultLineEnding"
                                     IsChecked="{Binding EditorSettings.IsDefaultLineEndingCRLF, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <TextBlock Text="Spell Check"
                                   FontSize="18"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Margin="0,12,0,8" />
                        <ComboBox SelectedIndex="{Binding EditorSettings.SpellCheckModeIndex, Source={StaticResource Locator}, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Auto Detect Language" />
                            <ComboBoxItem Content="Disabled" />
                        </ComboBox>
                        <TextBlock Text="Typewriter Mode"
                                   FontSize="18"
                                   Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                                   Margin="0,16,0,8" />
                        <CheckBox Content="Keep caret in middle when enabled"
                                  IsChecked="{Binding EditorSettings.KeepCaretInMiddleWhenTypewriterModeEnabled, Source={StaticResource Locator}, Mode=TwoWay}" />
                        <CheckBox Content="Enable Typewriter / Focus Mode"
                                  IsChecked="{Binding EditorSettings.TypewriterFocusModeEnabled, Source={StaticResource Locator}, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
