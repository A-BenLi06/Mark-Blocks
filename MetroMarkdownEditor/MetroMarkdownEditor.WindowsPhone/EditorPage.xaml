<Page
    x:Class="MetroMarkdownEditor.WindowsPhone.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:common="using:MetroMarkdownEditor.Common"
    xmlns:converters="using:MetroMarkdownEditor.Converters"
    mc:Ignorable="d"
    DataContext="{Binding Editor, Source={StaticResource Locator}}">

    <Page.Resources>
        <common:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:StringTruncateConverter x:Key="StringTruncateConverter" />

        <!-- Compact Tab Item Style -->
        <Style x:Key="CompactFileTabItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ColorContainer" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#888888" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected" />
                                    <VisualState x:Name="SelectedUnfocused" />
                                    <VisualState x:Name="SelectedPointerOver" />
                                    <VisualState x:Name="SelectedPressed" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <ContentControl x:Name="ColorContainer"
                                            Foreground="{Binding Theme.AccentBrush, Source={StaticResource Locator}}"
                                            FontWeight="SemiBold"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Center">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="4,2,4,2" />
                            </ContentControl>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RichEditBox style that doesn't change on focus -->
        <Style x:Key="NoFocusRichEditBoxStyle" TargetType="RichEditBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource ApplicationForegroundThemeBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichEditBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="ContentElement"
                                          Padding="{TemplateBinding Padding}"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          IsTabStop="False"
                                          ZoomMode="Disabled" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Page.BottomAppBar>
        <CommandBar x:Name="EditorCommandBar">
            <CommandBar.PrimaryCommands>
                <!-- Undo -->
                <AppBarButton x:Name="UndoButton" Label="Undo" Click="UndoButton_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Undo" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <!-- Immersive (WP新增) -->
                <AppBarButton x:Name="ImmersiveButton" Label="Immersive" Click="ImmersiveButton_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="FullScreen" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <!-- Mode -->
                <AppBarButton x:Name="ModeButton" Label="Mode" Click="ModeButton_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Refresh" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <!-- Save -->
                <AppBarButton x:Name="SaveButton" Label="Save" Click="SaveButton_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Save" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>

            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Redo" Click="RedoButton_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Redo" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarSeparator />

                <AppBarButton Label="New" Command="{Binding NewCommand}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Add" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarButton Label="Open" Command="{Binding OpenCommand}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarSeparator />

                <AppBarButton Label="Search" Click="SearchButton_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Find" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarButton Label="Outline" Click="OutlineButton_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="List" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarButton Label="Export to Markdown" Tag="md" Click="ExportButton_Click" />
                <AppBarButton Label="Export to HTML" Tag="html" Click="ExportButton_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid x:Name="LayoutRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Saving Progress Indicator -->
        <Grid Grid.RowSpan="2"
              VerticalAlignment="Top"
              Canvas.ZIndex="99"
              IsHitTestVisible="False"
              Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar Height="3" IsIndeterminate="True" Background="Transparent" />
            <TextBlock Text="{Binding SaveStatusText}"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"
                       Margin="0,5,10,0" />
        </Grid>

        <!-- TabBar -->
        <Border x:Name="TabBar"
                Grid.Row="0"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                BorderThickness="0"
                Padding="0,16,8,16"
                Height="96">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Accent Bar -->
                <Rectangle x:Name="AccentBar"
                           Grid.Column="0"
                           Width="6"
                           Fill="{Binding Theme.AccentBrush, Source={StaticResource Locator}}"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Left" />

                <!-- File Tabs -->
                <ListView x:Name="FileTabsListView"
                          Grid.Column="1"
                          Margin="8,0,0,0"
                          ItemsSource="{Binding OpenDocuments}"
                          SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                          SelectionMode="Single"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ItemContainerStyle="{StaticResource CompactFileTabItemStyle}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TitleText"
                                           Grid.Column="0"
                                           Text="{Binding Title, Converter={StaticResource StringTruncateConverter}, ConverterParameter=10}"
                                           FontSize="24"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Width="22" Height="22"
                                        Margin="4,0,0,0"
                                        Command="{Binding DataContext.CloseDocumentCommand, ElementName=LayoutRoot}"
                                        CommandParameter="{Binding}">
                                    <Button.Foreground>
                                        <Binding ElementName="TitleText" Path="Foreground" />
                                    </Button.Foreground>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="&#xE106;"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Content Area: Editor and Preview -->
        <Grid x:Name="ContentArea" Grid.Row="1">
            <!-- Editor Mode -->
            <Border x:Name="EditorContainer"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <RichEditBox x:Name="EditorBox"
                             Style="{StaticResource NoFocusRichEditBoxStyle}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             IsSpellCheckEnabled="False"
                             FontFamily="Consolas"
                             FontSize="18"
                             Padding="16,8,16,8"
                             TextChanged="EditorBox_TextChanged"
                             SelectionChanged="EditorBox_InputActivity"
                             LostFocus="EditorBox_LostFocus"
                             KeyDown="EditorBox_KeyDown" />
            </Border>

            <!-- Preview Mode -->
            <Border x:Name="PreviewContainer"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    Visibility="Collapsed">
                <WebView x:Name="PreviewWebView"
                         NavigationCompleted="PreviewWebView_NavigationCompleted" />
            </Border>
        </Grid>
    </Grid>
</Page>
