<SettingsFlyout
    x:Class="MetroMarkdownEditor.Windows.ExportSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Export"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Foreground="{ThemeResource ApplicationForegroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Margin="24,24,24,32">
            <TextBlock Text="Export Formats"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Margin="0,0,0,8" />
            <TextBlock Text="General, PDF, HTML, HTML without styles, Image, Word (.docx), OpenOffice, RTF, Epub, LaTeX, Media Wiki, reStructuredText, Textile, OPML"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Opacity="0.7"
                       TextWrapping="Wrap" />

            <TextBlock Text="General"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Margin="0,28,0,8" />
            <TextBlock Text="Default Folder for Exported File"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Margin="0,0,0,4" />
            <ComboBox SelectedIndex="{Binding DefaultFolderIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Auto" />
                <ComboBoxItem Content="Same folder with current file" />
                <ComboBoxItem Content="Custom location" />
            </ComboBox>
            <TextBox Text="{Binding CustomFolder, Mode=TwoWay}"
                     PlaceholderText="Custom export folder"
                     HorizontalAlignment="Stretch"
                     Margin="0,8,0,0" />

            <TextBlock Text="Pandoc Path"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Margin="0,16,0,4" />
            <TextBox Text="{Binding PandocPath, Mode=TwoWay}"
                     PlaceholderText="pandoc.exe"
                     HorizontalAlignment="Stretch" />

            <TextBlock Text="After Export"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Margin="0,28,0,8" />
            <CheckBox Content="Open exported file location"
                      IsChecked="{Binding OpenExportedFileLocation, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</SettingsFlyout>
