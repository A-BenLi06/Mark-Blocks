<SettingsFlyout
    x:Class="MetroMarkdownEditor.Windows.ThemeSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Personalization"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Foreground="{ThemeResource ApplicationForegroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Margin="24,24,24,24">
            <!-- Theme Switch -->
            <TextBlock Text="Theme"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Margin="0,0,0,8" />
            <TextBlock Text="Switch between light and dark for the editor and preview."
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Opacity="0.6"
                       Margin="0,0,0,8" />
            <ToggleSwitch Header="Dark theme"
                          IsOn="{Binding IsDarkTheme, Mode=TwoWay}" />

            <!-- Background Image Section -->
            <TextBlock Text="Background Theme"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Margin="0,24,0,8" />
            <TextBlock Text="Set a custom background image for the main page."
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Opacity="0.6"
                       Margin="0,0,0,12" />
            
            <Button x:Name="ChooseImageButton"
                    Content="Choose Image"
                    Click="ChooseBackground_Click"
                    HorizontalAlignment="Stretch"
                    Height="48"
                    FontSize="16"
                    Margin="0,0,0,8" />
            
            <Button x:Name="ResetImageButton"
                    Content="Reset to Default"
                    Click="ResetBackground_Click"
                    HorizontalAlignment="Stretch"
                    Height="48"
                    FontSize="16"
                    Visibility="{Binding UseCustomBackground, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Accent Color Section -->
            <TextBlock Text="Accent Color"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Margin="0,24,0,8" />
            <TextBlock Text="Use system accent color instead of the default cyan for tabs."
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Opacity="0.6"
                       Margin="0,0,0,8" />
            <ToggleSwitch Header="Use system accent color"
                          IsOn="{Binding UseSystemAccentColor, Mode=TwoWay}" />

            <!-- Preview Theme Section -->
            <TextBlock Text="Preview Theme"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Margin="0,24,0,8" />
            <TextBlock Text="Choose a background color for the markdown preview."
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       Opacity="0.6"
                       Margin="0,0,0,12" />
            <RadioButton Content="Default (Grey)"
                         GroupName="PreviewTheme"
                         IsChecked="{Binding IsPreviewThemeGrey, Mode=TwoWay}"
                         Margin="0,0,0,8" />
            <RadioButton Content="AMOLED Black"
                         GroupName="PreviewTheme"
                         IsChecked="{Binding IsPreviewThemeAMOLED, Mode=TwoWay}"
                         Margin="0,0,0,8" />
            <RadioButton Content="Tokyo Night"
                         GroupName="PreviewTheme"
                         IsChecked="{Binding IsPreviewThemeTokyoNight, Mode=TwoWay}"
                         Margin="0,0,0,8" />
        </StackPanel>
    </ScrollViewer>
</SettingsFlyout>
