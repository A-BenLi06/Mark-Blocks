<SettingsFlyout
    x:Class="MetroMarkdownEditor.Windows.AutoSaveSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Auto Save"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Foreground="{ThemeResource ApplicationForegroundThemeBrush}">

    <StackPanel Margin="24,24,24,24">
        <ToggleSwitch Header="Enable Auto Save"
                      IsOn="{Binding IsEnabled, Mode=TwoWay}"
                      Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Frequency (minutes)"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <Slider Width="220"
                    Minimum="1" Maximum="60" SmallChange="1" LargeChange="5"
                    Value="{Binding FrequencyMinutes, Mode=TwoWay}"
                    Margin="0,0,12,0" />
            <TextBlock Text="{Binding FrequencyMinutes}"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</SettingsFlyout>
